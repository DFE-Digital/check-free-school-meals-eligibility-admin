@using CheckYourEligibility.Admin.ViewModels
@using static CheckYourEligibility.Admin.Models.DateTimeExtensions
@using System.Globalization
@model CheckYourEligibility.Admin.ViewModels.BulkCheckViewModel;
@{
    ViewData["Title"] = "Batch checks history";
}

<div class="govuk-grid-column-full">
    <a class="govuk-back-link" href="@Url.Action("Bulk_Check", "BulkCheck")">Back</a>

    <div id="content" data-type="success" class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            @if (TempData["SuccessMessage"]?.ToString() != null)
            {
                <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
                    <div class="govuk-notification-banner__header">
                        <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
                            Success
                        </h2>
                    </div>
                    <div class="govuk-notification-banner__content">
                        <h3 class="govuk-notification-banner__heading">
                            @TempData["SuccessMessage"]
                        </h3>
                    </div>
                </div>
            }

            @if (TempData["ApplicationSuccess"] != null)
            {
                var targeted = Convert.ToInt32(TempData["EligibleTargeted"] ?? 0);
                var expanded = Convert.ToInt32(TempData["EligibleExpanded"] ?? 0);
                var total = targeted + expanded;

                var fileName = TempData["FileName"]?.ToString();

                var submittedDate = TempData["SubmittedDate"] is DateTime dt
                ? dt
                : DateTime.MinValue;

                <div class="govuk-notification-banner govuk-notification-banner--success"
                     role="alert"
                     aria-labelledby="govuk-notification-banner-title"
                     data-module="govuk-notification-banner">

                    <div class="govuk-notification-banner__header">
                        <h2 class="govuk-notification-banner__title"
                            id="govuk-notification-banner-title">
                            Applications successfully created
                        </h2>
                    </div>

                    <div class="govuk-notification-banner__content">
                        <h3 class="govuk-notification-banner__heading">
                            @total applications created for batch check @fileName
                            on @submittedDate.ToString("dd MMMM yyyy")
                        </h3>

                        <p class="govuk-body">
                            <strong class="govuk-tag govuk-tag--purple">
                                Eligible targeted
                            </strong>
                            <strong>@targeted</strong>
                        </p>

                        <p class="govuk-body">
                            <strong class="govuk-tag govuk-tag--green">
                                Eligible expanded
                            </strong>
                            <strong>@expanded</strong>
                        </p>
                    </div>
                </div>
            }

            else if (TempData["ErrorMessage"]?.ToString() != null)
            {
                <div class="govuk-error-summary" data-module="govuk-error-summary">
                    <div role="alert">
                        <h2 class="govuk-error-summary__title">
                            There is a problem
                        </h2>
                        <div class="govuk-error-summary__body">
                            <ul class="govuk-list govuk-error-summary__list">
                                <li>
                                    <p>@TempData["ErrorMessage"]</p>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            }

            <h1 class="govuk-heading-l">@ViewData["Title"]</h1>
            <p>If the status of a batch check is 'in progress', refresh the page to see if the check has completed.</p>

            @if (Model.Checks != null && Model.Checks.Any())
            {
                <table class="govuk-table govuk-table--small-text-until-tablet">
                    <caption class="govuk-table__caption govuk-table__caption--s govuk-!-margin-bottom-4">
                        Showing @Model.Checks?.Count batch files uploaded in the last 7 days
                    </caption>
                    <thead class="govuk-table__head">
                        <tr class="govuk-table__row">
                            <th scope="col" class="govuk-table__header">Filename</th>
                            <th class="govuk-table__cell">Number <br>of records</th>
                            <th class="govuk-table__cell">Final name <br>in check<br></th>
                            <th scope="col" class="govuk-table__header">Date submitted</th>
                            <th scope="col" class="govuk-table__header">Submitted by</th>
                            <th scope="col" class="govuk-table__header">Status</th>
                            <th scope="col" class="govuk-table__header">Actions </th>
                        </tr>
                    </thead>

                    <tbody class="govuk-table__body">
                        @foreach (var check in Model.Checks)
                        {
                            string tagClass;

                            switch (check.Status)
                            {
                                case "Not started":
                                    tagClass = "govuk-tag--grey";
                                    break;

                                case "In progress":
                                case "ApplicationCreationInProgress":
                                    tagClass = "govuk-tag--blue";
                                    break;

                                case "Completed":
                                    tagClass = "govuk-tag--yellow";
                                    break;
                                case "ApplicationsCreated":
                                    tagClass = "govuk-tag--green";
                                    break;

                                default:
                                    tagClass = "govuk-tag--red";
                                    break;
                            }
                            string? statusWording = null;
                            switch (check.Status)
                            {
                                case "Completed":
                                    statusWording = "Checks completed";
                                    break;
                                case "ApplicationCreationInProgress":
                                    statusWording = "Application creation in progress";
                                    break;
                                case "ApplicationsCreated":
                                    statusWording = "Applications created";
                                    break;
                                case "ApplicationCreationFailed":
                                    statusWording = "Application creation failed";
                                    break;
                            }
                            var showDelete =
                            check.Status == "Not started" ||
                            (check.Status == "Completed" && !Model.Enhanced);

                            var showViewResults =
                            check.Status == "Completed" &&
                            Model.Enhanced;

                            var showDownloadResults =
                            check.Status == "Completed" ||
                            check.Status == "ApplicationsCreated";

                            var showSearchApplications =
                            check.Status == "ApplicationsCreated";

                            <tr>
                                <td class="govuk-table__cell">@check.Filename</td>
                                <td class="govuk-table__cell">@check.NumberOfRecords</td>
                                <td class="govuk-table__cell">@check.FinalNameInCheck</td>
                                <td class="govuk-table__cell">@check.DateSubmitted.ToLocalString12HourFormatReadable()</td>
                                <td class="govuk-table__cell">@check.SubmittedBy</td>

                                <td class="govuk-table__cell">
                                    <strong class="govuk-tag @tagClass">@(statusWording ?? check.Status)</strong>
                                </td>

                                <td class="govuk-table__cell">
                                    <div class="govuk-table__actions">
                                        <ul class="govuk-table__actions-list">
                                            @if (showViewResults)
                                            {
                                                <li class="govuk-table__actions-list-item">@Html.ActionLink("View results", "Bulk_Check_Summary", "BulkCheck", new { bulkCheckId = check.BulkCheckId, DateSubmitted = check.DateSubmitted }, new { aria_label = $"View results submitted on {check.DateSubmitted.ToLocalString12HourFormatReadable()}" })</li>
                                            }
                                            @if (showSearchApplications)
                                            {

                                                <li class="govuk-table__actions-list-item">@Html.ActionLink("Search applications ", "SearchResults", "Application")</li>
                                            }
                                            @if (showDownloadResults)
                                            {

                                                <li class="govuk-table__actions-list-item">@Html.ActionLink("Download results", "Bulk_Check_Download", "BulkCheck", new { bulkCheckId = check.BulkCheckId }, new { aria_label = $"Download results submitted on {check.DateSubmitted.ToLocalString12HourFormatReadable()}" }) </li>
                                            }
                                            @if (showDelete)
                                            {
                                                <li class="govuk-table__actions-list-item">@Html.ActionLink("Delete", "Bulk_Check_Delete", "BulkCheck", new { bulkCheckId = check.BulkCheckId }, new { aria_label = $"Delete results submitted on {check.DateSubmitted.ToLocalString12HourFormatReadable()}" }) </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                var paginationModel = new PaginationPartialViewModel { CurrentPage = Model.CurrentPage, TotalPages = Model.TotalPages, RecordsPerPage = 10, TotalRecords = Model.TotalRecords, ControllerName = "Bulk_Check_History" };
                @Html.Partial("_PaginationPartial", paginationModel)
            }
            else
            {
                <p>No results found.</p>
            }
        </div>
    </div>
</div>

<script src="/js/bulk-check-status-refresh.js"></script>
