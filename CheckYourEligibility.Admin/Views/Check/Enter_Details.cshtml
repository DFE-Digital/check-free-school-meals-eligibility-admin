@using CheckYourEligibility.Admin.Domain.Constants
@using CheckYourEligibility.Admin.Domain.Constants.ErrorMessages
@using CheckYourEligibility.Admin.Domain.DfeSignIn
@model ParentGuardian

@{
    ViewData["Title"] = "Run a check for one parent or guardian";

    var orgType = TempData["organisationType"] as OrganisationCategory?;

    var ninoInputClasses = "govuk-input govuk-!-width-one-third js-nino-input";

    if (ViewData.ModelState["NationalInsuranceNumber"]?.Errors.Count > 0)
    {
        ninoInputClasses += " govuk-input--error";
    }

    var identifierRequiredError = new[]
    {
        nameof(Model.NationalInsuranceNumber),
        nameof(Model.NationalAsylumSeekerServiceNumber)
    }.Any(field => ViewData.ModelState[field]?.Errors.Any(
        error => error.ErrorMessage == ValidationMessages.NI_or_NASS) == true);

@functions {
    string InputClass(string fieldName)
    {
        return ViewData.ModelState[fieldName]?.Errors.Any() == true
            ? "govuk-input govuk-!-width-one-third govuk-input--error"
            : "govuk-input govuk-!-width-one-third";
    }
}
}

<div class="govuk-grid-column-two-thirds">
    <a class="govuk-back-link backLinkJS" href="@Url.Action("Index", "Home")">Back</a>

    @if (!ViewData.ModelState.IsValid)
    {
        <partial name="_ValidationSummaryParent" model="ViewData.ModelState" />
    }

    <h1 class="govuk-heading-l">@ViewData["Title"]</h1>
    <p class="govuk-body">Enter the details of the parent or guardian who applied for free school meals.</p>
    <form asp-controller="Check" asp-action="Enter_Details" method="post">
        <fieldset class="govuk-fieldset">
            <div class="govuk-form-group">
                <label class="govuk-label" for="FirstName">
                    First name
                </label>
                <p class="govuk-error-message">
                    <span asp-validation-for="FirstName"></span>
                </p>
                <input class="govuk-input govuk-input--width-20 @(ViewData.ModelState["FirstName"]?.Errors.Count > 0 ? "govuk-input--error" : "")"
                       asp-for="FirstName" type="text" autocomplete="given-name">
            </div>

            <div class="govuk-form-group">
                <label class="govuk-label" for="LastName">
                    Last name
                </label>
                <p class="govuk-error-message">
                    <span asp-validation-for="LastName"></span>
                </p>
                <input class="govuk-input govuk-input--width-20 @(ViewData.ModelState["LastName"]?.Errors.Count > 0 ? "govuk-input--error" : "")"
                       asp-for="LastName" type="text" autocomplete="family-name">
            </div>

            <div class="govuk-form-group">
                <label class="govuk-label" for="EmailAddress">
                    Email address (optional)
                </label>
                <p class="govuk-error-message">
                    <span asp-validation-for="EmailAddress"></span>
                </p>
                <input class="govuk-input govuk-input--width-20 @(ViewData.ModelState["EmailAddress"]?.Errors.Count > 0 ? "govuk-input--error" : "")"
                       asp-for="EmailAddress" type="text" autocomplete="email">
            </div>

            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                    <h1 id="dob-heading" class="govuk-label-wrapper">
                        <span class="govuk-label govuk-label--m">
                            Date of birth
                        </span>
                    </h1>

                    <div id="dob-hint" class="govuk-hint">
                        For example, 31 3 1980
                    </div>

                    <p class="govuk-error-message" id="dob-error">
                        <span asp-validation-for="DateOfBirth" class="govuk-error-message"></span>
                    </p>

                    <span id="dob-hint-day" class="govuk-visually-hidden">For example 31</span>
                    <div class="govuk-date-input"
                         id="DateOfBirth"
                         role="group"
                         aria-labelledby="dob-heading"
                         aria-describedby="dob-hint dob-error">

                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-date-input__label" for="DateOfBirth.Day">
                                    Day
                                </label>
                                <input class="govuk-input govuk-date-input__input govuk-input--width-2 @(ViewData.ModelState["DateOfBirth.Day"]?.Errors.Count > 0 ? "govuk-input--error" : "")"
                                       asp-for="Day"
                                       id="DateOfBirth.Day"
                                       aria-describedby="dob-hint-day"
                                       type="text"
                                       inputmode="numeric"
                                       maxlength="2" 
                                       autocomplete="bday-day" />
                            </div>
                        </div>

                        <span id="dob-hint-month" class="govuk-visually-hidden">For example 3</span>
                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-date-input__label" for="DateOfBirth.Month">
                                    Month
                                </label>
                                <input class="govuk-input govuk-date-input__input govuk-input--width-2 @(ViewData.ModelState["DateOfBirth.Month"]?.Errors.Count > 0 ? "govuk-input--error" : "")"
                                       asp-for="Month"
                                       id="DateOfBirth.Month"
                                       aria-describedby="dob-hint-month"
                                       type="text"
                                       inputmode="numeric"
                                       maxlength="2" 
                                       autocomplete="bday-month" />
                            </div>
                        </div>

                        <span id="dob-hint-year" class="govuk-visually-hidden">For example 1980</span>
                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-date-input__label" for="DateOfBirth.Year">
                                    Year
                                </label>
                                <input class="govuk-input govuk-date-input__input govuk-input--width-4 @(ViewData.ModelState["DateOfBirth.Year"]?.Errors.Count > 0 ? "govuk-input--error" : "")"
                                       asp-for="Year"
                                       id="DateOfBirth.Year"
                                       aria-describedby="dob-hint-year"
                                       type="text"
                                       inputmode="numeric"
                                       maxlength="4" 
                                       autocomplete="bday-year" />
                            </div>
                        </div>

                    </div>
                </fieldset>
            </div>
            <div class="govuk-form-group @(identifierRequiredError ? "govuk-form-group--error" : "")">
                <fieldset class="govuk-fieldset" aria-describedby="identifierType-hint @(identifierRequiredError ? "identifierType-error" : "")">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        National Insurance number or asylum support reference
                    </legend>

                    <div id="identifierType-hint" class="govuk-hint">
                        Select one option.
                    </div>

                    @if (identifierRequiredError)
                    {
                        <p class="govuk-error-message" id="identifierType-error">
                            <span class="govuk-visually-hidden">Error:</span>
                            @ValidationMessages.NI_or_NASS
                        </p>
                    }

                    <div class="govuk-radios" data-module="govuk-radios">
                        <div class="govuk-radios__item">
                            <input class="govuk-radios__input" id="identifierType-nino" asp-for="IdentifierType" type="radio" value="@IdentifierTypeConstants.Nino"
                                   data-aria-controls="conditional-identifierType-nino">
                            <label class="govuk-label govuk-radios__label" for="identifierType-nino">
                                National Insurance number
                            </label>
                        </div>
                        <div class="govuk-radios__conditional govuk-radios__conditional--hidden" id="conditional-identifierType-nino">
                            <div class="govuk-form-group">
                                <h1 class="govuk-label-wrapper">
                                    <label class="govuk-label" for="NationalInsuranceNumber">
                                        National Insurance number
                                    </label>
                                </h1>

                                <div id="NIN-hint" class="govuk-hint">
                                    For example, ‘QQ 12 34 56 C’
                                </div>

                                @if (!identifierRequiredError)
                                {
                                    <p class="govuk-error-message">
                                        <span asp-validation-for="NationalInsuranceNumber"></span>
                                    </p>
                                }
                                
                                <input class="@InputClass(nameof(Model.NationalInsuranceNumber))"
                                       id="NationalInsuranceNumber"
                                       aria-describedby="NIN-hint"
                                       asp-for="NationalInsuranceNumber"
                                       type="text"
                                       spellcheck="false" />
                            </div>
                        </div>
                        <div class="govuk-radios__item">
                            <input class="govuk-radios__input" id="identifierType-nass" asp-for="IdentifierType" type="radio" value="@IdentifierTypeConstants.Nass"
                                   data-aria-controls="conditional-identifierType-nass">
                            <label class="govuk-label govuk-radios__label" for="identifierType-nass">
                                Asylum support reference
                            </label>
                        </div>
                        <div class="govuk-radios__conditional govuk-radios__conditional--hidden" id="conditional-identifierType-nass">
                            <div class="govuk-form-group">
                                <label class="govuk-label" for="NationalAsylumSeekerServiceNumber">
                                    Asylum support reference
                                </label>
                                <div id="ASRN-hint" class="govuk-hint">
                                    For example, 123456789 or 12/34/56789
                                </div>

                                @if (!identifierRequiredError)
                                {
                                    <p class="govuk-error-message">
                                        <span asp-validation-for="NationalAsylumSeekerServiceNumber"></span>
                                    </p>

                                }
                                <input class="@InputClass(nameof(Model.NationalAsylumSeekerServiceNumber))"
                                       id="NationalAsylumSeekerServiceNumber"
                                       aria-describedby="ASRN-hint"
                                       asp-for="NationalAsylumSeekerServiceNumber"
                                       type="text"
                                       spellcheck="false" />
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <script src="/js/identifier.js"></script>

            <p class="govuk-body">
                <a target="_blank" href="https://www.gov.uk/government/publications/free-school-meals-guidance-for-schools-and-local-authorities/providing-free-school-meals-to-families-with-no-recourse-to-public-funds-nrpf">Parent or guardian has no recourse to public funds (NRPF)</a>
            </p>

            <button class="govuk-button govuk-!-margin-top-5" data-module="govuk-button">
                Run check
            </button>
        </fieldset>
    </form>
</div>

<script src="/js/validationSummary.js"></script>